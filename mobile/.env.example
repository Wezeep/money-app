# Backend API base URL (no trailing slash)
# - Dev profile (no Docker): backend runs on 8081 → http://localhost:8081
# - Default backend: http://localhost:8080
# - Android emulator: use 10.0.2.2 instead of localhost (e.g. http://10.0.2.2:8081)
# - Physical device: http://YOUR_COMPUTER_IP:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
